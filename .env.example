# Copy this file to `.env` for local Docker development.
# Copy to `.env.prod` for production and replace all example values.

DJANGO_SETTINGS_MODULE=ppw.settings.local
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

POSTGRES_DB=ppw
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_NAME=ppw
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=disable

CELERY_LOG_LEVEL=info
CHANNEL_REDIS_URL=redis://redis:6379/0

# Firebase Admin SDK Configuration. Keep this secret; never commit real credentials.
# Option 1: Separate service account credentials:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Option 2: Raw service-account JSON or path to service-account file:
FIREBASE_CREDENTIALS_JSON=

PEDIGREE_REPORT_BASE_URL=http://157.245.92.15
PEDIGREE_REPORT_API_KEY=change-me
PEDIGREE_REPORT_TIMEOUT=120

# Production notes:
# - set DJANGO_SETTINGS_MODULE=ppw.settings.production
# - set DEBUG=False
# - set ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS to your real domain(s)
# - set DB_HOST / DB_PORT / DB_SSLMODE for your production database
# - provide Firebase credentials only in the server secret environment
