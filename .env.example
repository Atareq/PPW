# Copy this file to `.env` for local Docker development.
# Copy this file to `.env.prod` for production and replace all example values.

# Django settings
DJANGO_SETTINGS_MODULE=ppw.settings.local
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# PostgreSQL container bootstrap values
POSTGRES_DB=ppw
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Django database connection values
DB_NAME=ppw
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=disable

# Celery
CELERY_LOG_LEVEL=info

# Pedigree FastReport provider
PEDIGREE_REPORT_BASE_URL=http://157.245.92.15
PEDIGREE_REPORT_TIMEOUT=120

# Production notes:
# - set DJANGO_SETTINGS_MODULE=ppw.settings.production
# - set DEBUG=False
# - set ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS to your real domain(s)
# - set DB_HOST / DB_PORT / DB_SSLMODE for your production database
